# marketing-tools/fastlane/Fastfile.common

# This file is shared across multiple projects.
# Usage: import "../../tools/marketing-tools/fastlane/Fastfile.common"

platform :android do
  desc "Generate Google Play metadata from tools/assets-config.json"
  lane :generate_metadata do |options|
    project_root = options[:project_root] || File.expand_path("../../", Dir.pwd)
    tools_dir = File.join(project_root, "tools", "marketing-tools")
    
    # Path to the script relative to this file's location
    script_path = File.expand_path("../../scripts/generate_gp_metadata.py", __FILE__)
    
    sh "python \"#{script_path}\" --root \"#{project_root}\""
  end

  desc "Organize screenshots for Fastlane upload"
  lane :organize_assets do |options|
    source_dir = options[:source] || "store-assets/extracted"
    project_root = options[:project_root] || File.expand_path("../../", Dir.pwd)
    
    script_path = File.expand_path("../../scripts/organize_gp_assets.py", __FILE__)
    
    sh "python \"#{script_path}\" --source \"#{source_dir}\" --root \"#{project_root}\""
  end

  desc "Capture screenshots using integration_test"
  lane :run_screenshot_test do |options|
    project_root = options[:project_root] || File.expand_path("../../", Dir.pwd)
    device_id = options[:device] || ENV["FLUTTER_DEVICE_ID"]
    device_arg = device_id ? "-d #{device_id}" : ""
    
    Dir.chdir(project_root) do
      # Run integration test to capture screenshots
      # Note: This requires a connected device or emulator
      sh "flutter drive #{device_arg} --driver=test_driver/integration_test.dart --target=integration_test/screenshot_test.dart"
    end
  end
end
